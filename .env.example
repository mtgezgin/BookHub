# .env.example — gereken env değişkenlerinin ŞABLONU (gerçek değerler .env'de, git dışı).
# Kullanım: cp .env.example .env  → .env'i düzenle. (.gitignore .env'i zaten dışlıyor.)
#
# NOT: Go uygulamamız .env dosyasını otomatik OKUMAZ (godotenv gibi bir paket yok —
# bilinçli tercih, §14.5). Değişkenleri shell'e yüklemek için:
#   set -a; source .env; set +a; go run ./cmd/api

# HTTP sunucusunun dinleyeceği port (boş bırakılırsa uygulama 8080'e düşer).
PORT=8080

# Postgres bağlantı dizesi (DSN). Biçim:
#   postgres://KULLANICI:SIFRE@HOST:PORT/VERITABANI?sslmode=...
# Aşağıdaki değer docker-compose.yml'deki dev container ile eşleşir.
# sslmode=disable SADECE lokal dev için geçerlidir; prod (Supabase) sslmode=require ister
# ve o DSN asla repoya girmez (deploy platformunun secret store'unda yaşar).
DATABASE_URL=postgres://bookhub:bookhub_dev@localhost:5432/bookhub?sslmode=disable

# Açılışta gömülü migration'ları uygula. Dev'de true (taze DB kendiliğinden hazır olur);
# PROD'DA false bırak: canlıda migration'ı Deploy iş akışı (.github/workflows/deploy.yml) yeni
# kod çıkmadan önce uygular — transaction pooler (6543) değil, session pooler üzerinden.
AUTO_MIGRATE=true

# JWT imza anahtarı (HS256) — ZORUNLU, en az 32 bayt; yoksa uygulama açılmaz.
# Aşağıdaki değer YALNIZCA lokal geliştirme içindir ve herkese açıktır (bu dosya repoda).
# Prod'da ASLA kullanma: `openssl rand -base64 48` ile üret, platformun secret store'una koy.
# Sızan bir JWT_SECRET ile herkes istediği rolde (ADMIN dahil) token imzalayabilir.
JWT_SECRET=dev-only-public-placeholder-change-me-in-prod-0123456789
# Access token ömrü (kısa tut: çalınırsa zarar penceresi bu kadar) ve refresh token ömrü.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# Bir girişin MUTLAK ömrü (varsayılan 720h = 30 gün). Refresh token her yenilemede
# JWT_REFRESH_TTL kadar uzar (kayan pencere); bu tavan onu keser — çalınmış bir oturum da en
# geç burada ölür ve herkes yeniden parola girer. JWT_REFRESH_TTL'den kısa olamaz.
JWT_SESSION_MAX_AGE=720h

# Refresh token artık cevabın gövdesinde değil, httpOnly bir ÇEREZDE taşınıyor (Faz 13).
#
# COOKIE_SECURE: çerezin Secure özniteliği — tarayıcı onu YALNIZ HTTPS'te geri gönderir.
# Varsayılan (ve prod'da tek doğru değer) true. Lokalde de true bırak: Chrome, Firefox ve
# curl http://localhost'u "güvenli bağlam" sayar, yani çerez düz HTTP'li compose'da da
# çalışır. Safari'de lokal HTTP ile sorun yaşarsan false yap — YALNIZ lokal için.
COOKIE_SECURE=true
# COOKIE_NAME: çerezin adı. Çerezler PORT'a göre değil HOST'a göre kapsanır (RFC 6265 §8.5):
# compose (localhost:3000), kind (localhost:3001) ve vite (localhost:5173) tarayıcı için tek
# bir "localhost" kavanozunu paylaşır. Aynı anda iki yığın çalıştırıyorsan her birine ayrı ad
# ver (kind ConfigMap'inde bookhub_refresh_k8s) — yoksa biri diğerinin oturumunu ezer.
# Yalnız RFC 6265 token karakterleri geçerli (harf, rakam, !#$%&'*+-.^_`|~); geçersiz bir ad
# açılışta reddedilir (aksi hâlde net/http çerezi sessizce düşürürdü).
COOKIE_NAME=bookhub_refresh

# Ağırlıklı puandaki m: "güvenilir sayılmak için gereken oy sayısı". Küçük başla (az veride
# büyük m her kitabı genel ortalamaya çökertir); katalog büyüdükçe artır.
RATING_MIN_VOTES=10

# Redis (Faz 7) — OPSİYONEL. Boş bırakılırsa cache kapalı ve rate limit bellek içi çalışır.
# Host portu 6380 (docker-compose.yml'deki notu gör). Prod'da Upstash URL'i (rediss://, TLS).
REDIS_URL=redis://localhost:6380/0

# login ve register için IP başına dakikada en çok istek (her biri ayrı sayılır).
AUTH_RATE_LIMIT_PER_MIN=10

# Log biçimi: text (dev, okunur) ya da json (konteyner/prod — log toplayıcılar için).
LOG_FORMAT=text

# X-Real-IP başlığına güvenilecek reverse proxy adresleri (CIDR ya da IP, virgülle).
# Boş = hiçbiri (doğrudan erişimde doğru ayar). Compose içinde NGINX adresi verilir.
TRUSTED_PROXIES=
