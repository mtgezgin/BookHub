# .env.example — gereken env değişkenlerinin ŞABLONU (gerçek değerler .env'de, git dışı).
# Kullanım: cp .env.example .env  → .env'i düzenle. (.gitignore .env'i zaten dışlıyor.)
#
# NOT: Go uygulamamız .env dosyasını otomatik OKUMAZ (godotenv gibi bir paket yok —
# bilinçli tercih, §14.5). Değişkenleri shell'e yüklemek için:
#   set -a; source .env; set +a; go run ./cmd/api

# HTTP sunucusunun dinleyeceği port (boş bırakılırsa uygulama 8080'e düşer).
PORT=8080

# Postgres bağlantı dizesi (DSN). Biçim:
#   postgres://KULLANICI:SIFRE@HOST:PORT/VERITABANI?sslmode=...
# Aşağıdaki değer docker-compose.yml'deki dev container ile eşleşir.
# sslmode=disable SADECE lokal dev için geçerlidir; prod (Supabase) sslmode=require ister
# ve o DSN asla repoya girmez (deploy platformunun secret store'unda yaşar).
DATABASE_URL=postgres://bookhub:bookhub_dev@localhost:5432/bookhub?sslmode=disable

# Açılışta gömülü migration'ları uygula. Dev'de true (taze DB kendiliğinden hazır olur);
# PROD'DA false bırak: Supabase'de migration pooler değil doğrudan bağlantıyla (5432),
# bilinçli bir adım olarak koşmalı.
AUTO_MIGRATE=true
