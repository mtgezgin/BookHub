# ---- Secrets & local env ----
# NEVER commit real secrets. Only .env.example is tracked.
.env
.env.*
!.env.example

# ---- Go ----
# Compiled binaries / build output
/bin/
/build/
/dist/
backend/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries & coverage
*.test
*.out
coverage.*
profile.cov

# Go workspace file
go.work
go.work.sum

# Vendor (we rely on the module cache, not vendoring)
/vendor/
backend/vendor/

# ---- Node / Frontend ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Docker / local data volumes ----
# make k8s-up'ın geçici imaj arşivi
.k8s-images.tar
# Local Postgres/Redis data if mounted into the repo
/data/
*.pgdata/

# ---- Editor / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Frontend build çıktısı (Vite)
frontend/dist/

# ---- Playwright (uçtan uca testler) ----
# Trace/rapor dosyaları ÇEREZLERİ ve istek gövdelerini (admin parolası dahil) içerir:
# repoya girmeleri düpedüz sır sızdırmak olurdu. Hepsi yeniden üretilebilir çıktı.
playwright-report/
test-results/
blob-report/
playwright/.cache/
